# Build output
.build/
.swiftpm/
build.noindex/
/Vendor/

# Dev runs (scripts/dev-run.sh): their indexes, models and settings
.dev/

# Python: the reference worker's environment
worker/.venv/
__pycache__/
*.pyc

# Your signing identity for local builds (see build.sh)
.sign-id

# Evals that name your own files
evals/*.local.json

.DS_Store

# The Tauri shell (shell/): Cargo builds and the schemas tauri-build writes
shell/src-tauri/target/
shell/src-tauri/gen/
face-worker/target/

# Local validation scratch files and tool caches (never release artifacts).
/work/

# Local design measurement and native capture scratch. Canonical approved mockups live in a subfolder.
.impeccable/build/
.impeccable/review/
.impeccable/mocks/*.png
.impeccable/mocks/*.json
